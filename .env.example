# FairRate Pay — Environment Variables Example
# Copy this file to '.env' or export these environment variables before running backend

# Razorpay TEST API Keys (sandbox mode only - no real money is moved)
# Get your free test keys at: https://dashboard.razorpay.com/ -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here
